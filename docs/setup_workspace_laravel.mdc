## 🚀 Scripts de Automação

### 1. Script de Setup Completo para Ubuntu
```bash
#!/bin/bash
# setup-ubuntu.sh

echo "🚀 Instalando Laravel via cURL com serviços pré-configurados..."

# Verificar se Docker está instalado
if ! command -v docker &> /dev/null; then
    echo "❌ Docker não encontrado. Instalando Docker..."
    sudo apt update
    sudo apt install docker.io docker-compose
    sudo systemctl start docker
    sudo systemctl enable docker
    sudo usermod -aG docker $USER
    echo "⚠️  IMPORTANTE: Faça logout e login novamente para aplicar as permissões do Docker"
    exit 1
fi

# Verificar se usuário está no grupo docker
if ! groups $USER | grep -q docker; then
    echo "❌ Usuário não está no grupo docker. Adicionando..."
    sudo usermod -aG docker $USER
    echo "⚠️  IMPORTANTE: Faça logout e login novamente para aplicar as permissões do Docker"
    exit 1
fi

# Obter o nome da pasta raiz dinamicamente
PROJECT_NAME=$(basename "$PWD")

# Instalar Laravel via cURL com todos os serviços usando o nome da pasta
curl -s "https://laravel.build/$PROJECT_NAME?with=pgsql,redis,mailpit,minio&devcontainer" | bash

# Mover arquivos da subpasta criada para a pasta raiz
echo "📁 Movendo arquivos da subpasta para a pasta raiz..."
if [ -d "$PROJECT_NAME" ]; then
    # Copiar todos os arquivos da subpasta para a pasta atual (evita problemas de permissão)
    cp -r "$PROJECT_NAME"/* . 2>/dev/null || true
    cp -r "$PROJECT_NAME"/.* . 2>/dev/null || true
    
    # Tentar remover a subpasta (se falhar, continuar)
    rm -rf "$PROJECT_NAME" 2>/dev/null || echo "⚠️  Não foi possível remover a subpasta (permissões), mas arquivos foram copiados"
    
    echo "✅ Arquivos copiados com sucesso para a pasta raiz"
    echo "🗑️  Subpasta removida (ou tentativa realizada)"
else
    echo "⚠️  Subpasta não encontrada, arquivos podem já estar na pasta raiz"
fi

# Após a movimentação, os arquivos estarão diretamente na pasta raiz

echo "🔧 Configurando ambiente..."

# Verificar e copiar configurações do guideline
echo "📋 Verificando arquivo guideline..."
GUIDELINE_FILE=$(find .guidelines -name "guideline*" -type f | head -1)

if [ -n "$GUIDELINE_FILE" ]; then
    echo "✅ Arquivo guideline encontrado: $(basename "$GUIDELINE_FILE")"
    echo "📁 Copiando arquivos de configuração..."
    
    # Copiar arquivos de configuração
    if [ -f ".guidelines/pint.json" ]; then
        cp .guidelines/pint.json ./
        echo "✅ pint.json copiado"
    fi
    
    if [ -f ".guidelines/phpstan.neon" ]; then
        cp .guidelines/phpstan.neon ./
        echo "✅ phpstan.neon copiado"
    fi
    
    if [ -f ".guidelines/grumphp.yml" ]; then
        cp .guidelines/grumphp.yml ./
        echo "✅ grumphp.yml copiado"
    fi
    
    echo "🎯 Configurações do projeto aplicadas!"
else
    echo "⚠️  Nenhum arquivo guideline encontrado, usando configurações padrão"
fi

# Dar permissão de execução ao Sail
chmod +x vendor/bin/sail

# Iniciar serviços
./vendor/bin/sail up -d

# Configurar ambiente
cp .env.example .env
./vendor/bin/sail artisan key:generate

# Executar migrations
./vendor/bin/sail artisan migrate

# Instalar ferramentas de qualidade
./vendor/bin/sail composer require laravel/pint --dev
./vendor/bin/sail composer require larastan/larastan --dev
./vendor/bin/sail composer require pestphp/pest --dev
./vendor/bin/sail composer require pestphp/pest-plugin-laravel --dev

# Configurar PestPHP
echo '<?php

use Pest\Laravel\TestCase;

uses(TestCase::class)->in("Feature", "Unit");' > tests/Pest.php

# Configurar Git hooks
./vendor/bin/sail exec laravel.test ./vendor/bin/grumphp git:init

# Verificar se as configurações foram aplicadas corretamente
echo "🔍 Verificando configurações aplicadas..."
if [ -f "pint.json" ]; then
    echo "✅ Laravel Pint configurado"
fi

if [ -f "phpstan.neon" ]; then
    echo "✅ Larastan configurado"
fi

if [ -f "grumphp.yml" ]; then
    echo "✅ GrumPHP configurado"
fi

if [ -f "tests/Pest.php" ]; then
    echo "✅ PestPHP configurado"
fi

echo "✅ Setup concluído!"
echo "🌐 Acesse: http://localhost"
echo "📧 Mailpit: http://localhost:8025"
echo "🗄️ MinIO Console: http://localhost:8901"
echo "🔍 Telescope: http://localhost/telescope"
```

