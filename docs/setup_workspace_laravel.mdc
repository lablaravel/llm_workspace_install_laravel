# Setup Workspace Laravel 13 (Sail + Redis + Queue + Horizon + Pulse + Telescope + Mail + MinIO)

## Objetivo
Provisionar um workspace Laravel 13 com Docker (Sail), Redis, filas, Horizon, Pulse, Telescope, Mailpit e MinIO.

Este setup é **interativo** e pergunta durante a execução:
- Qual ambiente aplicar (`local`, `staging`, `production`) com padrão `local` se vazio.
- Se deseja habilitar **Husky** para hooks Git.

## Stack padrão
- Laravel 13
- PostgreSQL
- Redis
- Queue (Redis)
- Horizon
- Pulse
- Telescope
- Mailpit (mail local)
- MinIO (S3 local)

## Pré-requisitos
```bash
docker --version
docker compose version
git --version
```

Opcional para SSL local com Traefik:
```bash
mkcert -help
```

Se o usuário não estiver no grupo docker (Linux):
```bash
sudo usermod -aG docker "$USER"
# faça logout/login após este comando
```

## Setup interativo

### 1. Script de bootstrap
Crie e execute o script abaixo na raiz do projeto.

```bash
cat > setup-workspace.sh <<'BASH'
#!/usr/bin/env bash
set -euo pipefail

PROJECT_NAME="$(basename "$PWD")"

read -r -p "Ambiente [local/staging/production] (default: local): " TARGET_ENV
TARGET_ENV="${TARGET_ENV:-local}"
case "$TARGET_ENV" in
  local|staging|production) ;;
  *)
    echo "Ambiente inválido. Usando local."
    TARGET_ENV="local"
    ;;
esac

read -r -p "Deseja habilitar Husky para hooks Git? [y/N]: " HUSKY_INPUT
HUSKY_INPUT="${HUSKY_INPUT:-N}"
HUSKY_INPUT="$(echo "$HUSKY_INPUT" | tr '[:upper:]' '[:lower:]')"
USE_HUSKY=false
if [[ "$HUSKY_INPUT" == "y" || "$HUSKY_INPUT" == "yes" || "$HUSKY_INPUT" == "s" || "$HUSKY_INPUT" == "sim" ]]; then
  USE_HUSKY=true
fi

echo "==> Instalando Laravel 13 com Sail e serviços (pgsql, redis, mailpit, minio)..."
# Sem devcontainer
curl -s "https://laravel.build/${PROJECT_NAME}?php=8.3&with=pgsql,redis,mailpit,minio" | bash

echo "==> Movendo arquivos para a raiz do workspace..."
if [ -d "$PROJECT_NAME" ]; then
  shopt -s dotglob
  cp -R "$PROJECT_NAME"/* . || true
  shopt -u dotglob
  rm -rf "$PROJECT_NAME" || true
fi

# Garantia extra para remover DevContainer caso tenha sido gerado por algum motivo
rm -rf .devcontainer || true

cp .env.example .env
chmod +x vendor/bin/sail

echo "==> Subindo containers..."
./vendor/bin/sail up -d

./vendor/bin/sail artisan key:generate

# Ajustes de ambiente
APP_DEBUG=false
TELESCOPE_ENABLED=false
if [ "$TARGET_ENV" = "local" ]; then
  APP_DEBUG=true
  TELESCOPE_ENABLED=true
fi

set_env() {
  local key="$1"
  local value="$2"
  if grep -q "^${key}=" .env; then
    sed -i "s#^${key}=.*#${key}=${value}#" .env
  else
    echo "${key}=${value}" >> .env
  fi
}

set_env APP_ENV "$TARGET_ENV"
set_env APP_DEBUG "$APP_DEBUG"
set_env LOG_CHANNEL stack
set_env LOG_LEVEL debug
set_env DB_CONNECTION pgsql
set_env DB_HOST pgsql
set_env DB_PORT 5432
set_env DB_DATABASE laravel
set_env DB_USERNAME sail
set_env DB_PASSWORD password
set_env QUEUE_CONNECTION redis
set_env CACHE_STORE redis
set_env REDIS_HOST redis
set_env REDIS_PORT 6379
set_env MAIL_MAILER smtp
set_env MAIL_HOST mailpit
set_env MAIL_PORT 1025
set_env MAIL_USERNAME null
set_env MAIL_PASSWORD null
set_env MAIL_ENCRYPTION null
set_env AWS_ACCESS_KEY_ID sail
set_env AWS_SECRET_ACCESS_KEY password
set_env AWS_DEFAULT_REGION us-east-1
set_env AWS_BUCKET laravel
set_env AWS_ENDPOINT http://minio:9000
set_env AWS_USE_PATH_STYLE_ENDPOINT true
set_env FILESYSTEM_DISK s3
set_env TELESCOPE_ENABLED "$TELESCOPE_ENABLED"

# Banco e filas
./vendor/bin/sail artisan migrate
./vendor/bin/sail artisan queue:failed-table || true
./vendor/bin/sail artisan migrate

# Horizon
./vendor/bin/sail composer require laravel/horizon
./vendor/bin/sail artisan horizon:install

# Pulse
./vendor/bin/sail composer require laravel/pulse
./vendor/bin/sail artisan pulse:install

# Telescope (somente dev por padrão)
if [ "$TARGET_ENV" = "local" ]; then
  ./vendor/bin/sail composer require laravel/telescope --dev
  ./vendor/bin/sail artisan telescope:install
  ./vendor/bin/sail artisan migrate
fi

# Dependências frontend
./vendor/bin/sail npm install

# Husky opcional
if [ "$USE_HUSKY" = true ]; then
  echo "==> Configurando Husky..."
  ./vendor/bin/sail npm install --save-dev husky
  ./vendor/bin/sail npm pkg set scripts.prepare="husky"
  ./vendor/bin/sail npm run prepare

  mkdir -p .husky
  cat > .husky/pre-commit <<'HOOK'
#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

./vendor/bin/sail exec laravel.test ./vendor/bin/pint
./vendor/bin/sail artisan test --compact
HOOK
  chmod +x .husky/pre-commit
fi

echo
echo "✅ Setup concluído"
echo "Ambiente: $TARGET_ENV"
echo "Husky: $USE_HUSKY"
echo "App: http://localhost"
echo "Mailpit: http://localhost:8025"
echo "MinIO Console: http://localhost:8901"
echo "Horizon: http://localhost/horizon"
if [ "$TARGET_ENV" = "local" ]; then
  echo "Telescope: http://localhost/telescope"
fi
echo "Pulse: http://localhost/pulse"
BASH

chmod +x setup-workspace.sh
./setup-workspace.sh
```

