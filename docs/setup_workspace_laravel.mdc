./vendor/bin/sail exec laravel.test ./vendor/bin/pint
./vendor/bin/sail exec laravel.test ./vendor/bin/phpstan analyse
./vendor/bin/sail artisan test
```

### Comandos para Verificação Dinâmica de Guidelines
```bash
# Listar todos os arquivos guideline disponíveis
find .guidelines -name "guideline*" -type f

# Verificar qual arquivo guideline será usado
GUIDELINE_FILE=$(find .guidelines -name "guideline*" -type f | head -1)
if [ -n "$GUIDELINE_FILE" ]; then
    echo "✅ Arquivo guideline ativo: $(basename "$GUIDELINE_FILE")"
    echo "📄 Conteúdo do arquivo:"
    head -5 "$GUIDELINE_FILE"
else
    echo "⚠️  Nenhum arquivo guideline encontrado"
fi

# Verificar se as configurações foram aplicadas corretamente
echo "🔧 Verificando configurações aplicadas:"
[ -f "pint.json" ] && echo "✅ Laravel Pint configurado" || echo "❌ Laravel Pint não configurado"
[ -f "phpstan.neon" ] && echo "✅ Larastan configurado" || echo "❌ Larastan não configurado"
[ -f "grumphp.yml" ] && echo "✅ GrumPHP configurado" || echo "❌ GrumPHP não configurado"
```

### Comandos para Verificação Dinâmica do Projeto
```bash
# Verificar o nome do projeto atual
PROJECT_NAME=$(basename "$PWD")
echo "📁 Nome do projeto atual: $PROJECT_NAME"

# Verificar o caminho completo
echo "📍 Caminho completo: $PWD"

# Verificar se estamos dentro do projeto Laravel (arquivos na pasta atual)
if [ -f "artisan" ]; then
    echo "✅ Estamos dentro do projeto Laravel"
    echo "📂 Conteúdo do diretório atual:"
    ls -la
    echo "🚀 Comandos disponíveis:"
    ./vendor/bin/sail artisan list | head -10
else
    echo "⚠️  Não estamos dentro do projeto Laravel"
    echo "💡 Execute o setup primeiro para instalar o Laravel na pasta atual"
fi
```

### Comandos para Movimentação Manual de Arquivos
```bash
# Se precisar mover arquivos manualmente de uma subpasta para a pasta raiz
PROJECT_NAME=$(basename "$PWD")

if [ -d "$PROJECT_NAME" ]; then
    echo "📁 Movendo arquivos de $PROJECT_NAME para a pasta raiz..."
    
    # Mover arquivos visíveis
    mv "$PROJECT_NAME"/* . 2>/dev/null || true
    
    # Mover arquivos ocultos (incluindo .env, .git, etc.)
    mv "$PROJECT_NAME"/.* . 2>/dev/null || true
    
    # Remover a subpasta vazia
    rmdir "$PROJECT_NAME" 2>/dev/null || true
    
    echo "✅ Arquivos movidos com sucesso"
else
    echo "⚠️  Subpasta $PROJECT_NAME não encontrada"
fi

# Verificar se a movimentação foi bem-sucedida
if [ -f "artisan" ]; then
    echo "✅ Laravel encontrado na pasta raiz"
    echo "📂 Estrutura do projeto:"
    ls -la | head -10
else
    echo "❌ Laravel não encontrado na pasta raiz"
fi
```

