includes:
  - ./vendor/larastan/larastan/extension.neon

parameters:
  level: 7
  paths:
    - app
    - routes
    - database/factories
    - database/seeders
  excludePaths:
    - bootstrap/cache/*
    - storage/*
    - vendor/*
    - database/migrations/*
  tmpDir: storage/framework/phpstan
  reportUnmatchedIgnoredErrors: true
  treatPhpDocTypesAsCertain: false
  ignoreErrors: []
